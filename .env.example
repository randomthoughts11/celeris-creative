# Copy to .env.local (local) and add the same keys in Vercel → Settings → Environment Variables.

# --- Option A: Resend (recommended) ---
# 1. Create account at https://resend.com
# 2. Create an API key
# 3. For production, verify celeriscreative.com and set EMAIL_FROM to something like:
#    Celeris Creative <forms@celeriscreative.com>
# Until the domain is verified, Resend only delivers reliably with:
#    EMAIL_FROM="Celeris Creative <onboarding@resend.dev>"
RESEND_API_KEY=
EMAIL_FROM="Celeris Creative <onboarding@resend.dev>"

# --- Option B: SMTP (also fine — yes, this alone is enough) ---
# Example for Google Workspace / custom mailbox:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ganesh@celeriscreative.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="Celeris Creative <ganesh@celeriscreative.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
