# Add these in Vercel → Settings → Environment Variables (Production + Preview), then Redeploy.

# --- Resend ---
# Env name MUST be exactly: RESEND_API_KEY
RESEND_API_KEY=
EMAIL_FROM="Celeris Creative <onboarding@resend.dev>"

# Optional override (defaults to ganesh@celeriscreative.com)
# CONTACT_TO_EMAIL=ganesh@celeriscreative.com

# IMPORTANT:
# With onboarding@resend.dev, Resend only delivers to the email you signed up with.
# To send to ganesh@celeriscreative.com for real:
#   1. Resend → Domains → add + verify celeriscreative.com
#   2. Set EMAIL_FROM="Celeris Creative <forms@celeriscreative.com>"
#   OR sign up for Resend using ganesh@celeriscreative.com

# --- SMTP alternative ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
